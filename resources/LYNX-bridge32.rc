#include <winuser.h>
#include <winver.h>
// the 32-bit plugin bridge (round 176a); lynx_version.h comes from scripts/build-windows-zig.sh
#include "lynx_version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "LYNX-bridge32.manifest"
1 ICON "LYNX.ico"

1 VERSIONINFO
 FILEVERSION    LYNX_VERSION_MAJOR, LYNX_VERSION_MINOR, LYNX_VERSION_PATCH, 0
 PRODUCTVERSION LYNX_VERSION_MAJOR, LYNX_VERSION_MINOR, LYNX_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Ka1-S"
            VALUE "FileDescription",  "LYNX SHARE 32-bit plugin bridge"
            VALUE "FileVersion",      LYNX_VERSION_STR
            VALUE "InternalName",     "LYNX-bridge32"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Ka1-S. Licensed under the GNU AGPL-3.0."
            VALUE "OriginalFilename", "LYNX-bridge32.exe"
            VALUE "ProductName",      "LYNX SHARE"
            VALUE "ProductVersion",   LYNX_VERSION_STR
            VALUE "Comments",         "https://github.com/Ka1-S/LYNX-SHARE"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
