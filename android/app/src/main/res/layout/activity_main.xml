<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".MainActivity">

    <!-- Top transport bar -->
    <LinearLayout
        android:id="@+id/transport_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/colorSurface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_play"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:text="@string/play"
            android:textColor="@color/colorText"
            android:backgroundTint="@color/colorAccent"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:text="@string/stop"
            android:textColor="@color/colorText"
            android:backgroundTint="@color/colorButtonInactive"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_record"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:text="@string/record"
            android:textColor="@color/colorText"
            android:backgroundTint="@color/colorButtonInactive"
            android:textSize="14sp"
            android:layout_marginEnd="16dp"/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:text="@string/save"
            android:textColor="@color/colorText"
            android:backgroundTint="@color/colorButtonInactive"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_load"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:text="@string/load"
            android:textColor="@color/colorText"
            android:backgroundTint="@color/colorButtonInactive"
            android:textSize="14sp"
            android:layout_marginEnd="16dp"/>

        <Button
            android:id="@+id/btn_export"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:text="@string/export_wav"
            android:textColor="@color/colorText"
            android:backgroundTint="@color/colorButtonInactive"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_import_flm"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:text="@string/import_flm"
            android:textColor="@color/colorText"
            android:backgroundTint="@color/colorButtonInactive"
            android:textSize="12sp"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/tv_tempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tempo"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginEnd="4dp"/>

        <SeekBar
            android:id="@+id/slider_tempo"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:max="120"
            android:progress="60"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_tempo_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120 · Sine"
            android:textColor="@color/colorText"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_ready"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Effects panel (horizontal slider row) -->
    <LinearLayout
        android:id="@+id/effects_panel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/colorSurface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/transport_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_delay_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delay"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"/>

        <SeekBar
            android:id="@+id/slider_delay_mix"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_delay_fb_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FB"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"/>

        <SeekBar
            android:id="@+id/slider_delay_fb"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tv_verb_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reverb"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"/>

        <SeekBar
            android:id="@+id/slider_reverb_mix"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_verb_room_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"/>

        <SeekBar
            android:id="@+id/slider_reverb_room"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"/>
    </LinearLayout>

    <!-- Main DAW canvas: Channel Rack | Piano Roll | Playlist | Mixer -->
    <io.github.danzfadlullah.lynx.ui.DawView
        android:id="@+id/daw_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/colorBackground"
        app:layout_constraintTop_toBottomOf="@id/effects_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
