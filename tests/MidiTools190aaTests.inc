TEST (mt190aa_random_tools_stay_in_lives_ranges)
{
    using namespace lynx::miditools;
    const auto& in = mt190aa::seven();
    const std::vector<int> chordKeys { 60, 64, 67, 72, 76, 79, 84, 88, 91 }; // the triad over 3 passes of +12
    for (std::uint32_t seed = 1; seed <= 40; ++seed)
    {
        // Random (Live: 91 91 72 67 76 64 91 76 on the chord): any note of any pass, at every 1/32
        ArpeggiateOptions a;
        a.style = ArpeggiateOptions::random;
        a.seed = seed;
        const auto r = arpeggiate (in, a);
        CHECK (r.size() == 26);
        for (std::size_t i = 0; i < 8 && i < r.size(); ++i)
            CHECK (std::find (chordKeys.begin(), chordKeys.end(), r[i].key) != chordKeys.end());
        // Random Other (Live: 60 67 64 | 72 76 79 | 91 84): every pass a new order of the three; Random Once (Live:
        // 60 67 64 | 72 79 76 | 84 91): one order for every pass
        for (int style : { (int) ArpeggiateOptions::randomOther, (int) ArpeggiateOptions::randomOnce })
        {
            a.style = style;
            const auto o = arpeggiate (in, a);
            CHECK (o.size() == 26);
            for (int pass = 0; pass < 2; ++pass)
            {
                std::vector<int> k;
                for (int i = 0; i < 3; ++i)
                    k.push_back (o[(std::size_t) (pass * 3 + i)].key - 12 * pass);
                auto sorted = k;
                std::sort (sorted.begin(), sorted.end());
                CHECK ((sorted == std::vector<int> { 60, 64, 67 }));
                if (style == ArpeggiateOptions::randomOnce && pass == 1)
                    CHECK (o[3].key - o[0].key == 12 && o[4].key - o[1].key == 12 && o[5].key - o[2].key == 12);
            }
        }

        // Connect Density 50 % (Live kept 1.75:64 and 2.75:71): only notes of the 100 % result, and never more
        ConnectOptions c;
        c.seed = seed;
        const auto full = connect (in, c, mt190o::grid);
        c.density = 0.5f;
        const auto half = connect (in, c, mt190o::grid);
        CHECK (half.size() >= in.size() && half.size() <= full.size());
        for (const auto& n : half)
            CHECK (std::find (full.begin(), full.end(), n) != full.end());
        // Spread 12 (Live: 56, 53 and 77 where 63, 64 and 71 were): within 12 semitones of the 0 st note
        c.density = 1.0f;
        c.spread = 12;
        const auto spread = connect (in, c, mt190o::grid);
        CHECK (spread.size() == full.size());
        for (std::size_t i = 0; i < spread.size() && i < full.size(); ++i)
            CHECK (std::abs (spread[i].key - full[i].key) <= 12 && spread[i].start == full[i].start);

        // Span Variation +-50 % (Live: lengths moved by -0.052 .. +0.061 beats): at most a quarter beat's half of a 1/16
        // grid, i.e. 0.0625 beats either way
        for (float v : { 0.5f, -0.5f })
        {
            SpanOptions sp;
            sp.variation = v;
            sp.seed = seed;
            const auto out = span (in, sp, mt190o::grid);
            CHECK (out.size() == in.size());
            for (std::size_t i = 0; i < out.size() && i < in.size(); ++i)
                CHECK (std::llabs (out[i].length - in[i].length) <= lynx::ppq / 16 && out[i].start == in[i].start);
        }
    }
    // the Live draws themselves lie inside those ranges
    for (double d : { -0.033077, -0.052226, -0.033377, 0.031673, 0.047214, 0.028216, 0.05348, -0.014373, 0.06056, 0.05933,
                      0.041978, 0.013251, 0.038118, -0.017787 })
        CHECK (std::abs (d) <= 0.0625);
}

