// Round 190aa: the MIDI Transformations (core/MidiTools.h) proven against Live 12.4.16, tool by tool. The expected notes
// are what Live saved after each tool on its own clip (/mnt/e/lynx-work/ableton190aa/live/mt3-saved Project/mt3-saved.als;
// the inputs are mt3-test.als; "time, key, length, velocity" in beats and 1..127). Random settings are checked by their
// ranges and structure over many seeds, with Live's one draw inside them.

#include "core/MidiTools.h"

namespace mt190aa
{
inline lynx::miditools::Notes notes (const std::vector<mt190o::Live>& live)
{
    lynx::miditools::Notes out;
    for (const auto& l : live)
        out.push_back (mt190o::note (l.time, l.key, l.length, (int) std::lround (l.velocity)));
    return out;
}
inline const lynx::miditools::Notes& seven() { static const auto n = mt190o::input(); return n; }
} // namespace mt190aa

