TEST (mt190aa_chop_variation_like_live)
{
    // Live at 50 % (part 1 x4): every note got the same shares 0.6146 0.0789 0.1327 0.1739; LYNX: each share scaled by a
    // random 1 +- 0.5, the same for every note
    using namespace lynx::miditools;
    for (std::uint32_t seed = 1; seed <= 30; ++seed)
    {
        ChopOptions o;
        o.emphasis = 0x1;
        o.stretch = 4;
        o.variation = 0.5f;
        o.seed = seed;
        const auto out = chop (mt190aa::seven(), o);
        CHECK (out.size() == 28);
        if (out.size() != 28)
            continue;
        // the chord's first three parts and the last note's: the same shares
        for (int i = 0; i < 3; ++i)
        {
            const auto share = (double) out[(std::size_t) (3 * i)].length / (double) lynx::ppq;
            const auto last = (double) out[(std::size_t) (24 + i)].length / (double) lynx::ppq;
            CHECK (std::abs (share - last) < 0.002);
            const auto base = i == 0 ? 4.0 / 7.0 : 1.0 / 7.0;
            CHECK (share > base * 0.5 / 1.5 - 0.002 && share < base * 1.5 / 0.5 + 0.002);
        }
    }
}

