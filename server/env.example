# /etc/lynx/lynx.env — created by setup.sh on the server only (chmod 600, root). Never commit the real file.
# LYNX_SALT is generated by setup.sh (random, salts the in-memory rate-limit keys).
LYNX_SALT=
LYNX_DATA_DIR=/var/lib/lynx
LYNX_PUBLIC_URL=https://api.lynx-share.com
LYNX_RELAY_PUBLIC_URL=wss://relay.lynx-share.com
# Share links (Online Sessions P1)
LYNX_SHARE_MAX_BYTES=2147483648
LYNX_SHARE_DEFAULT_DAYS=7
LYNX_SHARE_MAX_DAYS=30
LYNX_SHARE_TOTAL_BYTES=64424509440
LYNX_SHARE_CLIENT_DAILY_BYTES=8589934592
LYNX_SHARE_CREATES_PER_HOUR=20
LYNX_SHARE_INCOMPLETE_HOURS=24
LYNX_MIN_FREE_BYTES=10737418240
# Relay (Online Sessions P2/P4 skeleton)
LYNX_RELAY_MAX_PEERS=4
LYNX_RELAY_MAX_ROOMS=200
LYNX_RELAY_ROOM_HOURS=12
LYNX_RELAY_MAX_FRAME=1048576
LYNX_RELAY_PEER_BPS=4194304
LYNX_RELAY_ROOMS_PER_HOUR=10
